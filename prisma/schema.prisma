// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Replace with "mysql", "sqlite", etc., as per your setup
  url      = env("DATABASE_URL")
}

model Chat {
  uuid       String       @id @default(uuid()) @db.VarChar(191)
  user_id    String       @db.VarChar(191)
  title      String       @db.Text
  created_at DateTime     @default(now()) @db.Timestamp(3)

  @@map("chats") // Map the Prisma model to the actual table

  // One-to-many relationship with ChatHistory
  history    ChatHistory[]
}

model ChatHistory {
  uuid       String    @id @default(uuid()) @db.VarChar(191)
  chat_id    String    @db.VarChar(191)
  query      String    @db.Text
  response   String    @db.Text
  order      Int       @db.Int
  created_at DateTime  @default(now()) @db.Timestamp(3)

  @@map("chat_history") // Map the Prisma model to the actual table

  // Many-to-one relationship with Chat
  chat       Chat      @relation(fields: [chat_id], references: [uuid], onDelete: Cascade)

  // Index for foreign key (optional in Prisma, automatically generated by migrations)
  @@index([chat_id])
}